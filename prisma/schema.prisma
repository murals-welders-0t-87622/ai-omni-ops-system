  packageId       String
  packageKey      String
  packageName     String
  knowledgeBaseId String
  relationType    String   @default("DEFAULT")
  priority        Int      @default(100)
  retrievalMode   String   @default("HYBRID")
  isRequired      Boolean  @default(false)
  enabled         Boolean  @default(true)
  remarks         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([packageKey, knowledgeBaseId, relationType])
  @@index([packageKey, enabled, priority])
  @@index([knowledgeBaseId, enabled, priority])
}

model DigitalHumanFavoriteTemplate {
  id         String   @id @default(cuid())
  userId     String
  brandId    String
  templateId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, brandId, templateId])
  @@index([brandId, updatedAt])
  @@map("digital_human_favorite_templates")
}

model DigitalHumanScriptTemplate {
  id         String   @id @default(cuid())
  userId     String
  brandId    String
  name       String
  content    String
  note       String   @default("")
  isShared   Boolean  @default(false)
  category   String   @default("general")
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, brandId, updatedAt])
  @@index([brandId, category, updatedAt])
  @@index([brandId, isArchived, updatedAt])
  @@index([brandId, isShared, updatedAt])
  @@index([brandId, updatedAt])
  @@map("digital_human_script_templates")
}
